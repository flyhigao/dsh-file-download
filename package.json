{
  "name": "dsh-file-transfer",
  "version": "0.2.1",
  "description": "Add confirmed downloads and 1 GiB-capped, streamed uploads to DSH's file preview and workspace file tree.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyhigao/dsh-file-transfer.git"
  },
  "homepage": "https://github.com/flyhigao/dsh-file-transfer#readme",
  "bugs": {
    "url": "https://github.com/flyhigao/dsh-file-transfer/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "file-transfer",
    "file-download",
    "file-upload",
    "workspace"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.zh.md",
    "LICENSE",
    "lib",
    "client",
    "cordis.patch.yml",
    "screenshots.json",
    "assets"
  ]
}
